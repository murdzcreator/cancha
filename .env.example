# CANCHA V13 · configura solo las claves obtenidas en los sitios oficiales
# Copia este archivo como .env. Nunca compartas el archivo .env con terceros.
FOOTBALL_DATA_KEY=
API_FOOTBALL_KEY=
# TheSportsDB permite una clave pública v1 para el modo básico (cobertura limitada).
THESPORTSDB_KEY=123
# Consulta periódica pública de ESPN. Usa 0 para volver a archivos/proveedores previos.
CANCHA_ESPN=1
# Conserva parte del límite gratuito de API-Football por si se realizan varias consultas.
API_FOOTBALL_DAILY_BUDGET=75
PORT=4173
HOST=127.0.0.1

# Sincronización diaria de calendarios abiertos al ejecutar el servidor (en segundo plano).
CANCHA_OPENFOOTBALL=1
